# ===========================================================================
# 费用分摊与结算系统 —— 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都会在 config 层被读取（cost_Settlement/settings.py）
# ===========================================================================

# ---------------------------------------------------------------------------
# Django 基础配置
# ---------------------------------------------------------------------------
# 生产环境务必替换为随机长字符串：
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-key-please-override
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SERVICE_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 数据库（PostgreSQL）
# 格式：postgres://<user>:<password>@<host>:<port>/<dbname>
# 注意：口令里若含 @ : / 等特殊字符，需要做 URL 编码（如 @ -> %40）
# 留空则回退到项目根目录的 SQLite（仅用于快速试跑）
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cost_settlement

# ---------------------------------------------------------------------------
# AI：OpenAI 兼容接口（DeepSeek / 通义千问 / OpenAI 均可）
# 不填 OPENAI_API_KEY 时，AI 功能整体禁用并优雅降级，核心业务不受影响
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OpenAI 官方：   https://api.openai.com/v1        （模型 gpt-4o-mini）
# DeepSeek：      https://api.deepseek.com/v1      （模型 deepseek-chat）
# 通义千问：      https://dashscope.aliyuncs.com/compatible-mode/v1 （模型 qwen-plus）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# embedding 独立配置（可选，为空时回落到上面的 OPENAI_API_KEY / OPENAI_BASE_URL）
# DeepSeek 不提供 /embeddings 接口，chat 用 DeepSeek 时必须单独配置
# 通义千问：base_url=https://dashscope.aliyuncs.com/compatible-mode/v1，model=text-embedding-v4
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-v4
# 单次 LLM 调用超时（秒），超时即降级
OPENAI_TIMEOUT=10
# AI 总开关，设为 False 可整体关闭自然语言记账
AI_ENABLED=True
# 低于该置信度的解析结果直接丢弃，转人工录入
AI_CONFIDENCE_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
